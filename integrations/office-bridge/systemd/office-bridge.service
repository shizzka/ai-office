[Unit]
Description=Read-only DCM/JH observer for AI Office
Wants=ai-office.service
After=ai-office.service ai-office-ws.service

[Service]
Type=simple
WorkingDirectory=/home/q/work/office-bridge
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Europe/Moscow
ExecStart=/usr/bin/python3 -u /home/q/work/office-bridge/bridge.py --interval 18
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
